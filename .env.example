# Copy to .env.local. Do not commit secrets.

TRUEFORGE_BASE_URL=http://localhost:8790
# Cheapest OpenAI model in the TrueForge catalog once an OpenAI key is added.
TRUEFORGE_MODEL=openai/gpt-5-4-mini
# Optional. Default is http://127.0.0.1:$PORT/api/mcp
# DONECORNER_MCP_URL=http://127.0.0.1:3000/api/mcp
# TRUEFORGE_SANDBOX=1

# Local warehouse. Default matches `createdb donecorner` as the OS user.
DATABASE_URL=postgres://surendrapratap@127.0.0.1:5432/donecorner
# Docker Compose alternative: postgres://postgres@127.0.0.1:5432/donecorner

# Login. Required in production (Vercel env). Never commit real values.
# AUTH_SECRET=
# AUTH_CFO_PASSWORD=
# AUTH_FPNA_PASSWORD=

# OpenAI for TrueForge. Store only in Vercel / .env.local — never NEXT_PUBLIC_.
# OPENAI_API_KEY=
